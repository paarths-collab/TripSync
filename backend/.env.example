# backend/.env.example
# Copy to backend/.env and replace every placeholder. Never commit .env.

# --- Variables read by docker-compose.yml (PostgreSQL container) ---
POSTGRES_USER=postgres                 # Postgres superuser name for the local container
POSTGRES_PASSWORD=change-me            # Postgres password; must match the password in DATABASE_URL
POSTGRES_DB=tripsync_db                # Database name created in the container
POSTGRES_PORT=5433                     # Host port mapped to the container's 5432

# --- Variables read by the FastAPI app (app/core/config.py) ---
DATABASE_URL=postgresql://user:change-me@localhost:5433/tripsync            # SQLAlchemy URL for the database
ALLOW_ORIGINS=*                        # CORS allowed origins (comma-separated or "*")
JWT_SECRET_KEY=change-me               # Secret used to sign JWTs; use a long random value
JWT_ALGORITHM=HS256                    # JWT signing algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=60         # Lifetime of access tokens, in minutes
OLA_MAPS_API_KEY=your-ola-maps-key     # Ola Maps API key used by the map and routing endpoints
# OLA_MAPS_PROXY=http://proxy.example.invalid:8080   # Optional HTTP proxy for Ola Maps requests
