# backend/.env.example
# Copy to backend/.env and replace every placeholder. Never commit .env.

# --- Variables read by docker-compose.yml (PostgreSQL container) ---
POSTGRES_USER=postgres                 # Postgres superuser name for the local container
POSTGRES_PASSWORD=change-me            # Postgres password; must match the password in DATABASE_URL
POSTGRES_DB=tripsync_db                # Database name created in the container
POSTGRES_PORT=5433                     # Host port mapped to the container's 5432

# --- Variables read by the FastAPI app (app/core/config.py) ---
APP_NAME=TripSync                      # Shown in the API title, emails and the root message
DATABASE_URL=postgresql+psycopg2://user:change-me@localhost:5433/tripsync            # SQLAlchemy URL for the database (explicit psycopg2 driver)
# DB_AUTO_CREATE=false                 # create_all at startup; default: on for sqlite:// URLs, off otherwise (use `alembic upgrade head`)
ALLOW_ORIGINS=http://localhost:8081    # CORS origins, comma-separated; "*" allows any origin without credentials
JWT_SECRET_KEY=change-me               # Secret used to sign JWTs and hash email codes; use a long random value
JWT_ALGORITHM=HS256                    # JWT signing algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=60         # Lifetime of access tokens, in minutes
OLA_MAPS_API_KEY=your-ola-maps-key     # Ola Maps API key used by the map, places and routing endpoints
# OLA_MAPS_PROXY=http://proxy.example.invalid:8080   # Optional HTTP proxy for every Ola Maps request

# --- Colleges ---
# JSON object: college name -> accepted email domains. Colleges not listed keep the
# defaults (DJSCE -> djsce.ac.in; every other college closed until configured).
# COLLEGE_EMAIL_DOMAINS={"DJSCE": ["djsce.ac.in"], "SPIT": ["spit.ac.in"]}

# --- Email (verification and password-reset codes) ---
EMAIL_BACKEND=console                  # console: codes are written to the server log (development only); smtp: real email
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_USER=mailer
# SMTP_PASSWORD=change-me
# SMTP_STARTTLS=true
# EMAIL_FROM=no-reply@example.invalid

# --- Rate limiting (in-process; assumes a single worker) ---
# RATE_LIMIT_ENABLED=true
# Rules are "<count>/<seconds>" or "off". Defaults shown.
# RATE_LIMIT_LOGIN_IP=60/300
# RATE_LIMIT_LOGIN_EMAIL=10/600
# RATE_LIMIT_REGISTER_IP=60/3600
# RATE_LIMIT_VERIFY_REQUEST_IP=60/3600
# RATE_LIMIT_VERIFY_CONFIRM_IP=60/600
# RATE_LIMIT_VERIFY_CONFIRM_EMAIL=10/600
# RATE_LIMIT_PASSWORD_FORGOT_IP=30/3600
# RATE_LIMIT_PASSWORD_RESET_IP=60/600
# RATE_LIMIT_PASSWORD_RESET_EMAIL=10/600
# RATE_LIMIT_PLACES_USER=60/60
# RATE_LIMIT_ROUTE_USER=30/60
# RATE_LIMIT_CHAT_MESSAGE_USER=30/60
# TRUSTED_PROXY=false                  # true only behind your own reverse proxy: client IP from X-Forwarded-For
# TRUSTED_PROXY_HOPS=1                 # number of proxies that append to X-Forwarded-For

# --- Maps caches (in-process) ---
# PLACES_CACHE_TTL_SECONDS=600
# ROUTE_CACHE_TTL_SECONDS=120
# MAPS_CACHE_MAX_ENTRIES=1000
